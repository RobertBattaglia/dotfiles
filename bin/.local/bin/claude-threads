#!/usr/bin/env python3
"""Claude thread registry: durable per-session state for Claude Code sessions run in tmux.

One JSON file per Claude session_id in ${XDG_STATE_HOME:-~/.local/state}/claude-threads/threads/.
claude-tmux-state (the hook) writes the core fields; this CLI owns pin / snooze / settle and reconciliation.
Every writer takes the same per-thread mkdir lock (threads/.locks/<id>.lock) and writes tmp + rename.

Targets: @<window_id> | %<pane_id> | thread:<session_id> | <session_id or unique prefix> | (empty = current pane)

Usage:
  claude-threads list [--json]                    all threads, pinned first, newest activity first
  claude-threads show <target>                    metadata + recent prompts (fzf preview)
  claude-threads set <target> key=value ...       manual override (values parsed as JSON when possible)
  claude-threads pin <target> [--label TEXT]      pin; label defaults to Claude's task summary
  claude-threads unpin <target> | toggle-pin <target>
  claude-threads open <target> [--session NAME]   jump to the thread's window, or resume it in a new one in the tmux
                                                  session it was last in (recreated if gone; --session overrides)
  claude-threads snooze <target> [when...]        30m 2h 1h30m 3d 1w 45 | 14:30 9am | tomorrow [8am] | mon [10am]
                                                  | tonight [8] | today 4pm ; empty = last snooze used (first time 4h);
                                                  wake/off/0 wakes
  claude-threads snooze-prompt <window_id> [client]   tmux prompt pre-filled with the last snooze (<prefix>Z)
  claude-threads wake <target>
  claude-threads wake-due                         wake threads whose snooze has expired (called by claude-threads-tick)
  claude-threads settle <target> [--kill] [--confirm]   done with it: leaves active views, stays searchable/resumable
                                                  (--confirm asks y/n on the terminal first)
  claude-threads unsettle <target>
  claude-threads delete <target> [--yes]          PERMANENT: removes the registry entry, transcript, subagent logs,
                                                  file history; settled, closed threads only; asks twice unless --yes
  claude-threads prune [--dry-run]                delete empty threads (nothing but /clear-style commands, or no
                                                  transcript ever written) once closed; sweep does this automatically
  claude-threads sweep [--if-older-than SECONDS]  backfill transcripts, detect closed sessions, auto-settle
  claude-threads snapshot                         record tmux windows + Claude launch flags (claude-threads-tick, every 60s)
  claude-threads restore [--dry-run] [--yes] [--claude-only] [--hint] [--pause]
                                                  rebuild windows from the last snapshot of a tmux server that is gone; <prefix>R
  claude-threads inbox                            fzf over the registry (open, settle, snooze, pin); <prefix>i / W
                                                  views inbox / pinned / snoozed / settled, cycled with tab / shift-tab
                  [--rows [--view NAME] | --footer | --cycle next|previous | --settle-key T | --snooze-key T | --label-key T
                   | --delete-key T | --delete-bind T]

Environment / config ($STATE/claude-threads/config, KEY=VALUE lines; env wins):
  CLAUDE_THREADS_SETTLE_DAYS (SETTLE_DAYS)     auto-settle threads inactive this long (default 3)
  CLAUDE_SNOOZE_MORNING_HOUR (MORNING_HOUR)    hour used for "tomorrow" / weekdays with no time (default 9)
  CLAUDE_THREADS_PRUNE_EMPTY_HOURS (PRUNE_EMPTY_HOURS)   sweep deletes empty closed threads idle this long
                                                  (default 1; 0 turns auto-pruning off)
"""
import datetime
import glob
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import termios
import time
import tty

STATE_ROOT = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "claude-threads")
THREADS_DIR = os.path.join(STATE_ROOT, "threads")
LOCKS_DIR = os.path.join(THREADS_DIR, ".locks")
NEXT_WAKE_FILE = os.path.join(STATE_ROOT, "snooze_next_wake_at")
LAST_SNOOZE_FILE = os.path.join(STATE_ROOT, "last_snooze_spec")
FIRST_SNOOZE_DEFAULT = "4h"
SWEEP_STAMP_FILE = os.path.join(STATE_ROOT, ".last-sweep")
SWEEP_LOCK_DIR = os.path.join(STATE_ROOT, ".sweep.lock")
CLAUDE_CONFIG_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")   # same override Claude Code honors
CLAUDE_PROJECTS_DIR = os.path.join(CLAUDE_CONFIG_DIR, "projects")
CLAUDE_SESSIONS_DIR = os.path.join(CLAUDE_CONFIG_DIR, "sessions")
SPEAK_COMMAND = os.path.expanduser("~/.local/bin/claude-tmux-speak")
SNAPSHOT_DIR = os.path.join(STATE_ROOT, "tmux-snapshots")
SNAPSHOTS_KEPT = 5
CLAUDE_COMMAND = os.environ.get("CLAUDE_THREADS_CLAUDE_COMMAND") or "claude"   # override for tests
SESSION_ID_PATTERN = re.compile(r"^[A-Za-z0-9-]+$")
CLOSE_GRACE_SECONDS = 60
TRANSCRIPT_CHUNK_BYTES = 256 * 1024
AMBER, GREEN, RED, PURPLE, GRAY = "\033[38;2;245;158;11m", "\033[38;2;21;128;61m", "\033[38;2;185;28;28m", "\033[38;2;124;58;237m", "\033[38;2;156;163;175m"
DIM, RESET = "\033[2m", "\033[0m"


def load_config():
    config_values = {}
    config_path = os.path.join(STATE_ROOT, "config")
    if os.path.exists(config_path):
        for line in open(config_path):
            key, separator, value = line.strip().partition("=")
            if separator and not key.startswith("#"):
                config_values[key.strip()] = value.strip().strip("'\"")
    return config_values


CONFIG = load_config()
SETTLE_DAYS = float(os.environ.get("CLAUDE_THREADS_SETTLE_DAYS") or CONFIG.get("SETTLE_DAYS") or 3)
PRUNE_EMPTY_HOURS = float(os.environ.get("CLAUDE_THREADS_PRUNE_EMPTY_HOURS") or CONFIG.get("PRUNE_EMPTY_HOURS") or 1)
MORNING_HOUR = int(os.environ.get("CLAUDE_SNOOZE_MORNING_HOUR") or CONFIG.get("MORNING_HOUR") or 9)


def now_epoch():
    return int(time.time())


class CommandError(Exception):
    pass


# ---------------------------------------------------------------- tmux / output helpers

def in_tmux():
    return bool(os.environ.get("TMUX"))


def tmux(*arguments):
    """Run a tmux command; returns stdout (stripped) or None on failure."""
    try:
        completed = subprocess.run(["tmux", *arguments], capture_output=True, text=True)
    except FileNotFoundError:
        return None
    return completed.stdout.rstrip("\n") if completed.returncode == 0 else None


def notify(message):
    if in_tmux():
        tmux("display-message", message)
    else:
        print(message)


def speak(text):
    if os.access(SPEAK_COMMAND, os.X_OK):
        subprocess.Popen([SPEAK_COMMAND, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def format_clock(epoch_seconds, with_date=False):
    moment = datetime.datetime.fromtimestamp(epoch_seconds)
    return moment.strftime("%a %b %-d %H:%M" if with_date else "%a %H:%M")


def format_age(epoch_seconds):
    if not epoch_seconds:
        return "?"
    elapsed_seconds = max(0, now_epoch() - int(epoch_seconds))
    for unit_seconds, unit_name in ((86400, "d"), (3600, "h"), (60, "m")):
        if elapsed_seconds >= unit_seconds:
            return f"{elapsed_seconds // unit_seconds}{unit_name}"
    return "now"


def shorten_home(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path and path.startswith(home) else (path or "")


# ---------------------------------------------------------------- registry storage

def thread_path(session_id):
    return os.path.join(THREADS_DIR, session_id + ".json")


def acquire_lock(lock_dir, timeout_seconds=2.0, steal_when_stale=True):
    deadline = time.time() + timeout_seconds
    while True:
        try:
            os.mkdir(lock_dir)
            return True
        except FileExistsError:
            if time.time() > deadline:
                if not steal_when_stale:
                    return False
                try:
                    os.rmdir(lock_dir)
                except OSError:
                    pass
                deadline = time.time() + timeout_seconds
            time.sleep(0.01)


def release_lock(lock_dir):
    try:
        os.rmdir(lock_dir)
    except OSError:
        pass


def load_thread(session_id):
    try:
        with open(thread_path(session_id)) as thread_file:
            return json.load(thread_file)
    except (OSError, ValueError):
        return None


def update_thread(session_id, mutate):
    """Locked read-modify-write. `mutate(thread)` edits the dict in place. Never clobbers corrupt JSON."""
    if not SESSION_ID_PATTERN.match(session_id):
        raise CommandError(f"bad session id {session_id!r}")
    os.makedirs(LOCKS_DIR, exist_ok=True)
    lock_dir = os.path.join(LOCKS_DIR, session_id + ".lock")
    acquire_lock(lock_dir)
    try:
        path = thread_path(session_id)
        try:
            with open(path) as thread_file:
                thread = json.load(thread_file)
        except FileNotFoundError:
            thread = {}
        except ValueError:
            print(f"claude-threads: corrupt {path}, not modified", file=sys.stderr)
            return None
        before = json.dumps(thread, sort_keys=True)
        thread.setdefault("session_id", session_id)
        mutate(thread)
        if json.dumps(thread, sort_keys=True) != before:
            temporary_path = f"{path}.tmp.{os.getpid()}"
            with open(temporary_path, "w") as thread_file:
                json.dump(thread, thread_file, indent=1)
            os.replace(temporary_path, path)
        return thread
    finally:
        release_lock(lock_dir)


def all_threads():
    threads = []
    for path in glob.glob(os.path.join(THREADS_DIR, "*.json")):
        try:
            with open(path) as thread_file:
                threads.append(json.load(thread_file))
        except (OSError, ValueError):
            continue
    return threads


def live_claude_processes():
    """sessionId -> info from ~/.claude/sessions/<pid>.json for Claude processes still alive: interactive ones and
    background jobs (kind "bg", run by Claude's daemon and watched with `claude attach`)."""
    live_sessions = {}
    for session_file in glob.glob(os.path.join(CLAUDE_SESSIONS_DIR, "*.json")):
        try:
            with open(session_file) as handle:
                info = json.load(handle)
            os.kill(int(info["pid"]), 0)
        except PermissionError:
            pass
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if info.get("kind", "interactive") in ("interactive", "bg") and info.get("sessionId"):
            live_sessions[info["sessionId"]] = info
    return live_sessions


# ---------------------------------------------------------------- target resolution

def session_for_window(window_id):
    session_id = tmux("show", "-wv", "-t", window_id, "@claude_session_id")
    if session_id:
        return session_id
    for session_id, info in live_claude_processes().items():
        if f":{window_id}." in (info.get("tmux") or ""):
            return session_id
    candidates = [thread for thread in all_threads()
                  if thread.get("tmux_window_id") == window_id and thread.get("live_state") != "closed"]
    if candidates:
        return max(candidates, key=lambda thread: thread.get("last_activity_at") or 0)["session_id"]
    return None


def resolve_target(target):
    """Returns (session_id, window_id_or_None)."""
    target = (target or "").strip()
    if not target:
        target = os.environ.get("TMUX_PANE", "")
        if not target:
            raise CommandError("no target given and not inside tmux")
    if target.startswith("%"):
        window_id = tmux("display", "-p", "-t", target, "#{window_id}")
        if not window_id:
            raise CommandError(f"no such pane {target}")
        target = window_id
    if target.startswith("@"):
        session_id = session_for_window(target)
        if not session_id:
            raise CommandError("No Claude thread in this window")
        return session_id, target
    session_prefix = target.removeprefix("thread:")
    if os.path.exists(thread_path(session_prefix)):
        return session_prefix, None
    matches = [os.path.basename(path)[:-5] for path in glob.glob(os.path.join(THREADS_DIR, glob.escape(session_prefix) + "*.json"))]
    if len(matches) == 1:
        return matches[0], None
    raise CommandError(f"{'ambiguous' if matches else 'unknown'} thread {session_prefix!r}")


def live_window_of(session_id, thread=None):
    """The thread's window id, only if that window still holds this session."""
    thread = thread or load_thread(session_id) or {}
    window_id = thread.get("tmux_window_id")
    if window_id and tmux("show", "-wv", "-t", window_id, "@claude_session_id") == session_id:
        return window_id
    return None


def windows_holding_session(session_id):
    """Every tmux window whose @claude_session_id is this session (more than one if it was resumed twice)."""
    window_listing = tmux("list-windows", "-a", "-F", "#{window_id}\t#{@claude_session_id}") or ""
    return [window_id for window_id, _, window_session_id in (line.partition("\t") for line in window_listing.splitlines())
            if window_session_id == session_id]


def mirror_to_window(session_id, thread=None, window_id=None):
    """Push pin / snooze / settle markers from the registry onto every live window holding the thread."""
    thread = thread or load_thread(session_id) or {}
    window_ids = windows_holding_session(session_id)
    if window_id and window_id not in window_ids:
        window_ids.append(window_id)
    if not window_ids:
        return
    snoozed_until = thread.get("snoozed_until") or 0
    is_snoozed = snoozed_until > now_epoch()
    option_values = {
        "@claude_session_id": session_id,
        "@claude_pinned": "1" if thread.get("pinned") else "",
        "@claude_snoozed": "1" if is_snoozed else "",
        "@claude_snoozed_label": format_clock(snoozed_until) if is_snoozed else "",
        "@claude_snooze_news": "1" if is_snoozed and thread.get("snooze_news") else "",
        "@claude_settled": "1" if thread.get("settled") else "",
    }
    commands = []
    for target_window_id in window_ids:
        for option_name, option_value in option_values.items():
            if option_value:
                commands.extend(["set", "-w", "-t", target_window_id, option_name, option_value, ";"])
            else:
                commands.extend(["set", "-wu", "-t", target_window_id, option_name, ";"])
    tmux(*commands[:-1])


# ---------------------------------------------------------------- list / show / set

def thread_marks(thread):
    marks = ""
    if thread.get("pinned"):
        marks += AMBER + "^" + RESET
    if (thread.get("snoozed_until") or 0) > now_epoch():
        marks += GRAY + "zzz" + RESET
    if thread.get("settled"):
        marks += DIM + "s" + RESET
    outcome = thread.get("outcome")
    live_state = thread.get("live_state")
    if outcome == "needs_approval":
        marks += AMBER + "◆" + RESET
    elif outcome == "failed":
        marks += RED + "✗" + RESET
    elif live_state == "running":
        marks += PURPLE + "●" + RESET
    elif outcome == "done":
        marks += GREEN + "✓" + RESET
    return marks


HOST_NAMES = {name.lower() for name in (socket.gethostname(), socket.gethostname().split(".")[0]) if name}
SHELL_DEFAULT_TITLE_PATTERN = re.compile(r"^\S+@\S+:")   # "user@host:~/dir", what shells put in the title
VERSION_TITLE_PATTERN = re.compile(r"^v?\d+(\.\d+)+$")      # tmux auto-names a Claude window after its version
# Claude's title before it has summarized the task, and what tmux auto-names a window after its process.
GENERIC_TITLES = {"claude", "claude code", "zsh", "bash", "sh", "fish", "node"}


def is_useful_title(text):
    """False for placeholder titles: the host name or user@host:dir (tmux / shell defaults), a bare "Claude Code",
    or a process name."""
    text = (text or "").strip()
    return (bool(text) and text.lower() not in HOST_NAMES | GENERIC_TITLES
            and not SHELL_DEFAULT_TITLE_PATTERN.match(text) and not VERSION_TITLE_PATTERN.match(text))


def thread_title(thread):
    for candidate in (thread.get("pin_label"), thread.get("pane_title"), thread.get("title"), thread.get("window_name")):
        if is_useful_title(candidate):
            return candidate
    return "(untitled)"


def sort_key(thread):
    return (not thread.get("pinned"), -(thread.get("last_activity_at") or 0))


def command_list(arguments):
    threads = sorted(all_threads(), key=sort_key)
    if "--json" in arguments:
        json.dump(threads, sys.stdout, indent=1)
        print()
        return
    for thread in threads:
        visible_marks = re.sub(r"\033\[[0-9;]*m", "", thread_marks(thread))
        padding = " " * max(0, 6 - len(visible_marks))
        print(f"{thread['session_id'][:8]}  {thread_marks(thread)}{padding} {format_age(thread.get('last_activity_at')):>4}  "
              f"{(thread.get('live_state') or '?'):<7}  {DIM}{shorten_home(thread.get('cwd')):<40}{RESET}  {thread_title(thread)}")


def transcript_tail_entries(transcript_path, max_bytes=4 * TRANSCRIPT_CHUNK_BYTES):
    """Parsed entries from the last max_bytes of a transcript, oldest first ([] if unreadable)."""
    try:
        with open(transcript_path, "rb") as transcript:
            transcript.seek(0, os.SEEK_END)
            size = transcript.tell()
            transcript.seek(max(0, size - max_bytes))
            blob = transcript.read()
    except OSError:
        return []
    return [entry for entry in parse_json_lines(blob, size > max_bytes) if isinstance(entry, dict)]


def typed_prompt_text(entry):
    """The text you typed, for a top-level user prompt entry; None for tool results, commands, meta entries."""
    if entry.get("type") != "user" or entry.get("isSidechain") or entry.get("isMeta"):
        return None
    content = (entry.get("message") or {}).get("content")
    if isinstance(content, list):
        content = " ".join(block.get("text", "") for block in content if isinstance(block, dict) and block.get("type") == "text")
    if not isinstance(content, str) or not content.strip() or content.lstrip().startswith("<"):
        return None
    return " ".join(content.split())


def recent_prompts(entries, limit=5):
    """Last few user-typed prompts (local preview only)."""
    prompts = [prompt[:200] for prompt in map(typed_prompt_text, entries) if prompt]
    return prompts[-limit:]


# Footers Claude Code appends to a recap: "(disable / turn off recaps in /config)" and a date line ("2026-11-18",
# sometimes in *italics*), in either order.
RECAP_FOOTER_PATTERN = re.compile(r"(\s*\([^()]*recaps in /config\)|\s*\n\s*\*?\d{4}-\d{2}-\d{2}\*?)\s*$")


def strip_recap_footers(text):
    while True:
        stripped_text = RECAP_FOOTER_PATTERN.sub("", text)
        if stripped_text == text:
            return text
        text = stripped_text


def recap_text(entry):
    """Text of a session recap entry: Claude Code's automatic one (system/away_summary) or /recap's output."""
    if entry.get("type") != "system" or entry.get("isSidechain"):
        return None
    content = entry.get("content")
    if not isinstance(content, str):
        return None
    if entry.get("subtype") == "away_summary":
        text = content
    elif entry.get("subtype") == "local_command" and (entry.get("commandRun") or {}).get("command") == "recap":
        text = re.sub(r"</?local-command-stdout>", "", content)
    else:
        return None
    return strip_recap_footers(text.strip()).strip() or None


def latest_recap(entries):
    """(recap text, its epoch time, prompts you typed after it) for the newest recap, or None."""
    prompts_after = 0
    for entry in reversed(entries):
        text = recap_text(entry)
        if text:
            return text, iso_to_epoch(entry.get("timestamp")), prompts_after
        if typed_prompt_text(entry):
            prompts_after += 1
    return None


def command_show(arguments):
    session_id, _ = resolve_target(arguments[0] if arguments else "")
    thread = load_thread(session_id) or {"session_id": session_id}
    print(f"{thread_marks(thread)} {thread_title(thread)}")
    print(f"{DIM}{session_id}{RESET}")
    detail_rows = [
        ("dir", shorten_home(thread.get("cwd"))),
        ("branch", thread.get("git_branch")),
        ("state", thread.get("live_state")),
        ("outcome", " ".join(filter(None, [thread.get("outcome"), thread.get("outcome_detail")]))),
        ("active", (lambda age: "just now" if age == "now" else f"{age} ago")(format_age(thread.get("last_activity_at")))
                   if thread.get("last_activity_at") else None),
        ("started", format_clock(thread["started_at"], True) if thread.get("started_at") else None),
        ("snoozed", format_clock(thread["snoozed_until"], True) if (thread.get("snoozed_until") or 0) > now_epoch() else None),
        ("settled", f"{thread.get('settled_reason')} {format_age(thread.get('settled_at'))} ago" if thread.get("settled") else None),
    ]
    for label, value in detail_rows:
        if value:
            print(f"  {label:<8} {value}")
    transcript_path = thread.get("transcript_path")
    if transcript_path and not os.path.exists(transcript_path):
        print(f"  {RED}transcript deleted; not resumable{RESET}")
    elif transcript_path:
        entries = transcript_tail_entries(transcript_path)
        recap = latest_recap(entries)
        if recap:
            text, recap_time, prompts_after = recap
            age = format_age(recap_time) if recap_time else None
            when = ("just now" if age == "now" else f"{age} ago") if age else ""
            since = f", {prompts_after} prompt{'s' if prompts_after != 1 else ''} since" if prompts_after else ""
            print(f"\nRecap{f' ({when}{since})' if when or since else ''}:")
            print(f"  {text}")
        prompts = recent_prompts(entries)
        if prompts:
            print("\nRecent prompts:")
            for prompt in prompts:
                print(f"  › {prompt}")


def command_set(arguments):
    if len(arguments) < 2:
        raise CommandError("usage: claude-threads set <target> key=value ...")
    session_id, _ = resolve_target(arguments[0])
    assignments = {}
    for assignment in arguments[1:]:
        key, separator, raw_value = assignment.partition("=")
        if not separator or not key:
            raise CommandError(f"bad assignment {assignment!r}")
        try:
            assignments[key] = json.loads(raw_value)
        except ValueError:
            assignments[key] = raw_value
    thread = update_thread(session_id, lambda thread: thread.update(assignments))
    if thread is not None:
        mirror_to_window(session_id, thread)
        if "snoozed_until" in assignments:
            recompute_next_wake()


# ---------------------------------------------------------------- pin

def resume_flags_for_session(session_id):
    """Launch flags of the live claude process, carried over like claude-restart-all does."""
    info = live_claude_processes().get(session_id)
    if not info:
        return None
    return launch_flags_by_pid([info["pid"]]).get(int(info["pid"]))


def launch_flags_by_pid(process_ids):
    """pid -> carried launch flags (shell-quoted string) for each still-running process, from a single ps call."""
    if not process_ids:
        return {}
    ps_output = subprocess.run(["ps", "-o", "pid=,args=", "-p", ",".join(str(process_id) for process_id in process_ids)],
                               capture_output=True, text=True).stdout
    flags_by_pid = {}
    for line in ps_output.splitlines():
        process_id, _, process_arguments = line.strip().partition(" ")
        if process_id.isdigit():
            flags_by_pid[int(process_id)] = launch_flags_from_arguments(process_arguments.split())
    return flags_by_pid


def launch_flags_from_arguments(process_arguments):
    carried_flags = []
    argument_index = 0
    while argument_index < len(process_arguments):
        argument = process_arguments[argument_index]
        if argument in ("--permission-mode", "--model", "--add-dir", "--agent") and argument_index + 1 < len(process_arguments):
            carried_flags += [argument, process_arguments[argument_index + 1]]
            argument_index += 1
        elif argument in ("--dangerously-skip-permissions", "--chrome", "--verbose"):
            carried_flags.append(argument)
        argument_index += 1
    return " ".join(shlex.quote(flag) for flag in carried_flags)


def command_pin(arguments):
    if not arguments:
        raise CommandError("usage: claude-threads pin <target> [--label TEXT]")
    session_id, window_id = resolve_target(arguments[0])
    label = arguments[arguments.index("--label") + 1] if "--label" in arguments[1:-1] else ""
    label = re.sub(r"^[^A-Za-z0-9]+", "", label).strip()   # the prompt is pre-filled with the raw title (spinner glyph)
    window_id = window_id or live_window_of(session_id)
    pane_title = window_name = None
    if window_id:
        # only a title Claude (or you) set is a useful label, not tmux's / the shell's default
        pane_title = re.sub(r"^[^A-Za-z0-9]+", "", tmux("display", "-p", "-t", window_id, "#{pane_title}") or "")
        pane_title = pane_title if is_useful_title(pane_title) else None
        window_name = tmux("display", "-p", "-t", window_id, "#{window_name}")
    resume_flags = resume_flags_for_session(session_id)
    process_cwd = (live_claude_processes().get(session_id) or {}).get("cwd")

    def apply_pin(thread):
        thread["pinned"] = True
        thread["pinned_at"] = thread.get("pinned_at") or now_epoch()
        stored_label = thread.get("pin_label") if is_useful_title(thread.get("pin_label")) else None
        thread["pin_label"] = label or stored_label or pane_title or thread_title(dict(thread, pin_label=None, window_name=window_name))
        if window_id:
            thread.setdefault("tmux_window_id", window_id)
        if resume_flags is not None:
            thread["resume_flags"] = resume_flags
        if process_cwd and not thread.get("cwd"):
            thread["cwd"] = process_cwd

    thread = update_thread(session_id, apply_pin)
    mirror_to_window(session_id, thread, window_id)
    notify(f"Pinned: {thread_title(thread)}")


def command_unpin(arguments):
    session_id, window_id = resolve_target(arguments[0] if arguments else "")
    thread = update_thread(session_id, lambda thread: thread.update(pinned=False, pinned_at=None))
    mirror_to_window(session_id, thread, window_id)


def command_toggle_pin(arguments):
    session_id, _ = resolve_target(arguments[0] if arguments else "")
    if (load_thread(session_id) or {}).get("pinned"):
        command_unpin(arguments)
    else:
        command_pin(arguments[:1])


def resume_launch(session_id, thread):
    """(launch directory, shell command) that resumes the thread with its original flags; falls back to a shell."""
    transcript_path = thread.get("transcript_path")
    if transcript_path and not os.path.exists(transcript_path):
        raise CommandError("transcript was deleted; this thread can't be resumed")
    thread_cwd = thread.get("cwd") or os.path.expanduser("~")
    launch_directory = existing_directory(thread_cwd)
    recovery_hint = ""
    if launch_directory != thread_cwd:
        notify(f"claude-threads: {thread_cwd} is missing; resuming from {launch_directory}")
        git_branch = thread.get("git_branch") or "<branch>"
        recovery_message = (f"claude-threads: {thread_cwd} is gone (removed worktree?). Recreate it, e.g. "
                            f"git worktree add {thread_cwd} {git_branch}, then: cd {thread_cwd} && claude --resume {session_id}")
        recovery_hint = f"echo {shlex.quote(recovery_message)}; "
    resume_flags = thread.get("resume_flags") or ""
    resume_command = (f"{CLAUDE_COMMAND} {resume_flags + ' ' if resume_flags else ''}--resume {session_id} "
                      f"|| {{ {recovery_hint}true; }}; exec \"$SHELL\" -l")
    return launch_directory, resume_command


def existing_directory(path):
    """path, or its nearest existing parent."""
    while path and path != "/" and not os.path.isdir(path):
        path = os.path.dirname(path)
    return path or "/"


def attach_thread_to_window(session_id, thread, window_id):
    """Point the registry at a freshly created window and mirror the thread's markers onto it."""
    update_thread(session_id, lambda thread: thread.update(tmux_window_id=window_id))
    mirror_to_window(session_id, load_thread(session_id), window_id)


def new_window_in_session(session_name, launch_directory, shell_command=None, window_name=None):
    """New detached window in the named session, creating the session if it's gone. Returns the window id or None.
    session_name None means the current session."""
    name_arguments = ["-n", window_name] if window_name else []
    command_arguments = [shell_command] if shell_command else []
    if session_name is None:
        creation = ["new-window", "-d", "-P", "-F", "#{window_id}"]
    elif tmux("has-session", "-t", f"={session_name}") is not None:
        creation = ["new-window", "-d", "-P", "-F", "#{window_id}", "-t", f"={session_name}:"]
    else:
        creation = ["new-session", "-d", "-P", "-F", "#{window_id}", "-s", session_name]
    return tmux(*creation, *name_arguments, "-c", launch_directory, *command_arguments)


AUTOMATIC_WINDOW_NAME_PATTERN = re.compile(r"^(claude|node|zsh|bash|sh|fish|login|nvim|vim|\d+(\.\d+)+)$|\[(tmux|dead)\]")


def reopen_window_name(thread):
    """Name for a reopened thread's window, or None to leave tmux's automatic renaming on (like a fresh window).
    A name you gave the window comes back; an automatic one (claude, zsh, ...) isn't pinned down. The pin label
    is only used when no window name was ever recorded. Threads recorded before the hook stored window_named
    are judged by the name itself."""
    window_name = thread.get("window_name") or ""
    if window_name:
        window_was_named = thread.get("window_named")
        if window_was_named is None:
            window_was_named = not AUTOMATIC_WINDOW_NAME_PATTERN.search(window_name)
        return window_name[:40] if window_was_named else None
    pin_label = thread.get("pin_label") if thread.get("pinned") else None
    return pin_label[:40] if pin_label else None


def command_open(arguments):
    if not arguments:
        raise CommandError("usage: claude-threads open <target> [--session NAME]")
    session_id, _ = resolve_target(arguments[0])
    requested_session = arguments[arguments.index("--session") + 1] if "--session" in arguments[1:-1] else None
    thread = load_thread(session_id)
    if not thread:
        raise CommandError(f"unknown thread {session_id}")
    live_window = live_window_of(session_id, thread)
    if live_window:
        tmux("switch-client", "-t", live_window)
        return
    launch_directory, resume_command = resume_launch(session_id, thread)
    target_session = requested_session or thread.get("tmux_session_name")
    new_window_id = new_window_in_session(target_session, launch_directory, resume_command, reopen_window_name(thread))
    if not new_window_id:
        raise CommandError(f"couldn't open a window in tmux session {target_session or '(current)'}")
    attach_thread_to_window(session_id, thread, new_window_id)
    tmux("switch-client", "-t", new_window_id)


# ---------------------------------------------------------------- snooze

WEEKDAY_NAMES = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
DURATION_UNITS = {"m": 60, "min": 60, "mins": 60, "minute": 60, "minutes": 60,
                  "h": 3600, "hr": 3600, "hrs": 3600, "hour": 3600, "hours": 3600,
                  "d": 86400, "day": 86400, "days": 86400,
                  "w": 604800, "wk": 604800, "wks": 604800, "week": 604800, "weeks": 604800}


def parse_wake_time(specification, current_time=None):
    """Human snooze spec -> epoch seconds, or None if unparseable."""
    current_time = current_time or datetime.datetime.now()
    spec = " ".join(specification.lower().split())
    if re.fullmatch(r"\d+", spec):
        return int(current_time.timestamp()) + int(spec) * 60
    duration_parts = re.findall(r"(\d+)\s*([a-z]+)", spec)
    if duration_parts and re.fullmatch(r"(\s*\d+\s*[a-z]+)+", spec):
        if all(unit in DURATION_UNITS for _, unit in duration_parts):
            total_seconds = sum(int(amount) * DURATION_UNITS[unit] for amount, unit in duration_parts)
            return int(current_time.timestamp()) + total_seconds if total_seconds > 0 else None
    day_match = re.fullmatch(r"(today|tonight|tomorrow|tmrw|mon|tue|wed|thu|fri|sat|sun)[a-z]*(?: (?:at )?(.*))?", spec)
    day_word, time_part = (day_match.group(1), day_match.group(2) or "") if day_match else ("", spec)
    if not time_part:
        if day_word == "tonight":
            hour, minute = 19, 0
        elif day_word in ("", "today"):
            return None
        else:
            hour, minute = MORNING_HOUR, 0
    else:
        time_match = re.fullmatch(r"(\d{1,2})(?::(\d{2}))?\s*(am|pm)?", time_part)
        if not time_match:
            return None
        hour, minute, meridiem = int(time_match.group(1)), int(time_match.group(2) or 0), time_match.group(3)
        if meridiem:
            if not 1 <= hour <= 12:
                return None
            hour = hour % 12 + (12 if meridiem == "pm" else 0)
        elif day_word == "tonight" and hour < 12:
            hour += 12
        if hour > 23 or minute > 59:
            return None
    day_offset = 0
    if day_word in ("tomorrow", "tmrw"):
        day_offset = 1
    elif day_word in WEEKDAY_NAMES:
        day_offset = (WEEKDAY_NAMES.index(day_word) - current_time.weekday()) % 7 or 7
    wake_time = (current_time + datetime.timedelta(days=day_offset)).replace(hour=hour, minute=minute, second=0, microsecond=0)
    if wake_time <= current_time:
        if day_word:
            return None   # "today 9am" / "tonight" already past
        wake_time += datetime.timedelta(days=1)   # bare time rolls to tomorrow
    return int(wake_time.timestamp())


def recompute_next_wake():
    pending_wakes = [thread["snoozed_until"] for thread in all_threads() if isinstance(thread.get("snoozed_until"), (int, float)) and thread["snoozed_until"] > 0]
    if pending_wakes:
        temporary_path = f"{NEXT_WAKE_FILE}.tmp.{os.getpid()}"
        with open(temporary_path, "w") as next_wake_handle:
            next_wake_handle.write(f"{int(min(pending_wakes))}\n")
        os.replace(temporary_path, NEXT_WAKE_FILE)
    else:
        try:
            os.remove(NEXT_WAKE_FILE)
        except FileNotFoundError:
            pass


def default_snooze_spec():
    """The last snooze time you used (so Enter repeats it), 4h the first time."""
    try:
        with open(LAST_SNOOZE_FILE) as last_snooze_file:
            return last_snooze_file.read().strip() or FIRST_SNOOZE_DEFAULT
    except OSError:
        return FIRST_SNOOZE_DEFAULT


def remember_snooze_spec(specification):
    temporary_path = f"{LAST_SNOOZE_FILE}.tmp.{os.getpid()}"
    with open(temporary_path, "w") as last_snooze_file:
        last_snooze_file.write(specification + "\n")
    os.replace(temporary_path, LAST_SNOOZE_FILE)


def command_snooze(arguments):
    if not arguments:
        raise CommandError("usage: claude-threads snooze <target> [when...]")
    session_id, window_id = resolve_target(arguments[0])
    specification = " ".join(arguments[1:]).strip() or default_snooze_spec()
    if specification.lower() in ("wake", "off", "0", "none"):
        wake_thread(session_id, "manual")
        notify("Woke thread")
        return
    wake_epoch = parse_wake_time(specification)
    if wake_epoch is None:
        raise CommandError(f"Can't parse '{specification}' (try 30m, 2h, 14:30, tomorrow 9am, mon)")
    remember_snooze_spec(specification)

    def apply_snooze(thread):
        thread.update(snoozed_until=wake_epoch, snoozed_at=now_epoch(), snooze_news=None)
        if thread.get("settled"):
            thread.update(settled=False, settled_at=None, settled_reason=None, unsettled_at=now_epoch())

    thread = update_thread(session_id, apply_snooze)
    mirror_to_window(session_id, thread, window_id)
    recompute_next_wake()
    notify(f"Snoozed until {format_clock(wake_epoch, True)}")


def snooze_question(thread):
    if is_snoozed(thread, now_epoch()):
        return f"Snoozed until {format_clock(thread['snoozed_until'])}. New time or 'wake'"
    return "Snooze (30m 2h 14:30 tomorrow mon; wake)"


def command_snooze_prompt(arguments):
    """<prefix>Z: tmux prompt pre-filled with the default, so Enter repeats the last snooze."""
    if not arguments:
        raise CommandError("usage: claude-threads snooze-prompt <window_id> [client]")
    window_id = arguments[0]
    session_id, _ = resolve_target(window_id)
    client_arguments = ["-t", arguments[1]] if len(arguments) > 1 and arguments[1] else []
    tmux("command-prompt", *client_arguments, "-I", default_snooze_spec(), "-p", snooze_question(load_thread(session_id) or {}) + ":",
         f"run-shell \"claude-threads snooze '{window_id}' '%%'\"")


def read_line_from_terminal(prompt):
    """Line input on the controlling terminal (inside fzf execute()); None when there's no terminal."""
    try:
        with open("/dev/tty", "w") as terminal_output, open("/dev/tty") as terminal_input:
            terminal_output.write(prompt)
            terminal_output.flush()
            return terminal_input.readline().strip()
    except OSError:
        return None


def wake_thread(session_id, wake_reason):
    previous = load_thread(session_id) or {}
    snooze_news = previous.get("snooze_news")
    thread = update_thread(session_id, lambda thread: thread.update(
        snoozed_until=None, snooze_news=None, snooze_woke_at=now_epoch(),
        snooze_woke_reason=wake_reason, snooze_woke_with_news=snooze_news))
    window_id = live_window_of(session_id, thread)
    mirror_to_window(session_id, thread, window_id)
    if window_id and wake_reason == "timer":
        # Snooze means "remind me later": bring the window back as your turn unless Claude is mid-turn.
        if thread.get("live_state") != "running":
            tmux("set", "-w", "-t", window_id, "@claude_waiting", "1", ";",
                 "set", "-w", "-t", window_id, "@claude_outcome", thread.get("outcome") or "done")
        is_watched, window_name = (tmux("display", "-p", "-t", window_id, "#{&&:#{window_active},#{session_attached}}\t#{window_name}") or "0\t").split("\t", 1)
        if is_watched != "1":
            suffix = {"needs_approval": "needs input while snoozed", "done": "done while snoozed",
                      "failed": "failed while snoozed"}.get(snooze_news, "snooze over")
            speak(f"{thread.get('pin_label') or window_name or 'Claude'} {suffix}")
    recompute_next_wake()


def command_wake(arguments):
    session_id, _ = resolve_target(arguments[0] if arguments else "")
    wake_thread(session_id, "manual")


def command_wake_due(arguments):
    os.makedirs(STATE_ROOT, exist_ok=True)
    if not acquire_lock(SWEEP_LOCK_DIR + ".wake", timeout_seconds=0, steal_when_stale=False):
        return
    try:
        current_time = now_epoch()
        for thread in all_threads():
            snoozed_until = thread.get("snoozed_until")
            if isinstance(snoozed_until, (int, float)) and 0 < snoozed_until <= current_time:
                wake_thread(thread["session_id"], "timer")
        recompute_next_wake()
    finally:
        release_lock(SWEEP_LOCK_DIR + ".wake")


# ---------------------------------------------------------------- settle

def read_keypress(prompt):
    """Show prompt on the controlling terminal and read one key without Enter (works inside fzf execute() and
    tmux popups). Returns the key as bytes, or None when there's no terminal."""
    try:
        terminal_fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return None
    try:
        os.write(terminal_fd, prompt.encode())
        saved_attributes = termios.tcgetattr(terminal_fd)
        try:
            tty.setcbreak(terminal_fd)
            key = os.read(terminal_fd, 1)
        finally:
            termios.tcsetattr(terminal_fd, termios.TCSADRAIN, saved_attributes)
        os.write(terminal_fd, b"\n")
        return key
    finally:
        os.close(terminal_fd)


def confirm_on_terminal(question):
    """y/n on a single keypress; anything but y (or no terminal) means no."""
    return read_keypress(f"{question} (y/n) ") in (b"y", b"Y")


def command_settle(arguments):
    should_kill_window = "--kill" in arguments
    should_confirm = "--confirm" in arguments
    positional_arguments = [argument for argument in arguments if argument not in ("--kill", "--confirm")]
    session_id, window_id = resolve_target(positional_arguments[0] if positional_arguments else "")
    if should_confirm and not confirm_on_terminal(f"Settle '{thread_title(load_thread(session_id) or {})}'?"):
        return

    def apply_settle(thread):
        thread.update(settled=True, settled_at=thread.get("settled_at") or now_epoch(),
                      settled_reason=thread.get("settled_reason") or "manual", snoozed_until=None, snooze_news=None)

    thread = update_thread(session_id, apply_settle)   # pins are kept: settling only leaves active views
    window_id = window_id or live_window_of(session_id, thread)
    recompute_next_wake()
    if should_kill_window and window_id:
        tmux("kill-window", "-t", window_id)
        return
    mirror_to_window(session_id, thread, window_id)
    notify(f"Settled: {thread_title(thread)}")


def command_unsettle(arguments):
    session_id, window_id = resolve_target(arguments[0] if arguments else "")

    def apply_unsettle(thread):
        if thread.get("settled"):
            thread.update(settled=False, settled_at=None, settled_reason=None, unsettled_at=now_epoch())

    thread = update_thread(session_id, apply_unsettle)
    mirror_to_window(session_id, thread, window_id)
    notify(f"Unsettled: {thread_title(thread)}")


# ---------------------------------------------------------------- delete: permanent removal + pruning empty threads

# User entries that start with one of these never reached the model: slash commands (/clear, /model, ...), their
# output, and !bash-mode input/output.
LOCAL_ONLY_PROMPT_PREFIXES = ("<command-name>", "<command-message>", "<local-command-", "<bash-input>", "<bash-stdout>", "<bash-stderr>")
EMPTY_TRANSCRIPT_MAX_BYTES = 1024 * 1024   # anything bigger is assumed to hold a conversation without reading it


def transcript_has_conversation(transcript_path):
    """True once a transcript holds any assistant reply or any prompt actually sent to Claude (text, image, ...).
    A /clear (or /model, /mcp, !ls ...) followed by nothing has no conversation. Unreadable or large = True."""
    try:
        if os.path.getsize(transcript_path) > EMPTY_TRANSCRIPT_MAX_BYTES:
            return True
        with open(transcript_path, "rb") as transcript:
            for entry in parse_json_lines(transcript.read(), False):
                if not isinstance(entry, dict):
                    continue
                if entry.get("type") == "assistant":
                    return True
                if entry.get("type") != "user" or entry.get("isMeta"):
                    continue
                content = (entry.get("message") or {}).get("content")
                blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content or []
                for block in blocks:
                    if not isinstance(block, dict):
                        continue
                    if block.get("type") != "text":
                        return True
                    text = (block.get("text") or "").strip()
                    if text and not text.startswith(LOCAL_ONLY_PROMPT_PREFIXES):
                        return True
    except OSError:
        return True
    return False


def thread_is_empty(thread):
    """Nothing worth keeping: an empty transcript, or a hook-only thread whose transcript never existed
    (sweep records transcript_mtime whenever it sees one, so its absence means Claude never wrote it)."""
    transcript_path = thread.get("transcript_path")
    if transcript_path and os.path.exists(transcript_path):
        return not transcript_has_conversation(transcript_path)
    return thread.get("source") == "hook" and "transcript_mtime" not in thread and not thread.get("title")


def session_artifact_paths(session_id):
    """Everything Claude Code keeps for a session (session_id is validated, so it is safe inside a glob)."""
    candidates = (glob.glob(os.path.join(CLAUDE_PROJECTS_DIR, "*", session_id + ".jsonl"))
                  + glob.glob(os.path.join(CLAUDE_PROJECTS_DIR, "*", session_id))                # subagents, tool results
                  + glob.glob(os.path.join(CLAUDE_CONFIG_DIR, "todos", session_id + "-*.json"))
                  + [os.path.join(CLAUDE_CONFIG_DIR, "file-history", session_id),
                     os.path.join(CLAUDE_CONFIG_DIR, "session-env", session_id)])
    return [path for path in candidates if os.path.lexists(path)]


def delete_thread_permanently(session_id):
    """Remove the thread and all of its Claude Code artifacts. The transcript has to go too, or the next sweep
    would backfill the thread right back. Returns the removed paths."""
    if not SESSION_ID_PATTERN.match(session_id):
        raise CommandError(f"bad session id {session_id!r}")
    lock_dir = os.path.join(LOCKS_DIR, session_id + ".lock")
    acquire_lock(lock_dir)
    removed_paths = []
    try:
        for path in session_artifact_paths(session_id) + [thread_path(session_id)]:
            try:
                if os.path.isdir(path) and not os.path.islink(path):
                    shutil.rmtree(path)
                else:
                    os.remove(path)
                removed_paths.append(path)
            except FileNotFoundError:
                continue
    finally:
        release_lock(lock_dir)
    return removed_paths


def deletion_blocker(session_id, thread, live_sessions=None):
    """Why this thread can't be deleted right now, or None."""
    live_sessions = live_claude_processes() if live_sessions is None else live_sessions
    if session_id in live_sessions or thread.get("live_state") == "running":
        return "it's still running; quit Claude in that window first"
    return None


def describe_for_deletion(thread):
    transcript_path = thread.get("transcript_path")
    if not transcript_path or not os.path.exists(transcript_path):
        return "no transcript"
    size_kib = os.path.getsize(transcript_path) / 1024
    contents = "conversation" if transcript_has_conversation(transcript_path) else "empty"
    return f"{contents}, {size_kib:.0f} KiB transcript"


def command_delete(arguments):
    skip_confirmation = "--yes" in arguments
    positional_arguments = [argument for argument in arguments if argument != "--yes"]
    session_id, _ = resolve_target(positional_arguments[0] if positional_arguments else "")
    thread = load_thread(session_id) or {}
    if not thread.get("settled"):
        raise CommandError("only settled threads can be deleted (settle it first)")
    blocker = deletion_blocker(session_id, thread)
    if blocker:
        raise CommandError(f"can't delete: {blocker}")
    title = thread_title(thread)
    if not skip_confirmation:
        if not confirm_on_terminal(f"Delete '{title}' ({describe_for_deletion(thread)})?"):
            return
        if not confirm_on_terminal(f"{RED}This permanently erases the transcript and cannot be undone or resumed. "
                                   f"Are you sure?{RESET}"):
            return
    delete_thread_permanently(session_id)
    notify(f"Deleted: {title}")


def prunable_threads(current_time=None, live_sessions=None):
    """Empty, closed threads idle for PRUNE_EMPTY_HOURS. Pinned threads are kept: a pin is a deliberate choice."""
    current_time = current_time or now_epoch()
    live_sessions = live_claude_processes() if live_sessions is None else live_sessions
    idle_seconds = PRUNE_EMPTY_HOURS * 3600
    prunable = []
    for thread in all_threads():
        session_id = thread.get("session_id")
        if (not session_id or not SESSION_ID_PATTERN.match(session_id) or thread.get("pinned")
                or deletion_blocker(session_id, thread, live_sessions)
                or current_time - (thread.get("last_activity_at") or thread.get("started_at") or 0) < idle_seconds):
            continue
        if thread_is_empty(thread):
            prunable.append(thread)
    return prunable


def prune_empty_threads(live_sessions=None, dry_run=False):
    if PRUNE_EMPTY_HOURS <= 0:
        return []
    prunable = prunable_threads(live_sessions=live_sessions)
    if not dry_run:
        for thread in prunable:
            delete_thread_permanently(thread["session_id"])
    return prunable


def command_prune(arguments):
    dry_run = "--dry-run" in arguments
    if PRUNE_EMPTY_HOURS <= 0 and not dry_run:
        print("auto-pruning is off (PRUNE_EMPTY_HOURS=0)")
        return
    pruned = prunable_threads() if dry_run else prune_empty_threads()
    for thread in pruned:
        print(f"{'would delete' if dry_run else 'deleted'}  {thread['session_id'][:8]}  "
              f"{format_age(thread.get('last_activity_at')):>4}  {shorten_home(thread.get('cwd')):<40}  {thread_title(thread)}")
    print(f"{len(pruned)} empty thread{'s' if len(pruned) != 1 else ''} {'would be ' if dry_run else ''}deleted")


# ---------------------------------------------------------------- sweep: backfill + reconcile + auto-settle

def iso_to_epoch(timestamp):
    try:
        return int(datetime.datetime.fromisoformat(timestamp.replace("Z", "+00:00")).timestamp())
    except (AttributeError, ValueError):
        return None


def parse_json_lines(blob, skip_first_partial_line):
    for line in blob.split(b"\n")[1 if skip_first_partial_line else 0:]:
        try:
            yield json.loads(line)
        except ValueError:
            continue


def parse_transcript(transcript_path, file_size):
    """Metadata from a transcript's head and tail: cwd, branch, start/last activity, title, final outcome."""
    found = {}
    with open(transcript_path, "rb") as transcript:
        for entry in parse_json_lines(transcript.read(TRANSCRIPT_CHUNK_BYTES), False):
            if entry.get("timestamp") and entry.get("cwd"):
                found.update(started_at=iso_to_epoch(entry["timestamp"]), cwd=entry["cwd"], git_branch=entry.get("gitBranch"))
                break
        transcript.seek(max(0, file_size - TRANSCRIPT_CHUNK_BYTES))
        tail_entries = list(parse_json_lines(transcript.read(), file_size > TRANSCRIPT_CHUNK_BYTES))
    for entry in reversed(tail_entries):
        entry_type = entry.get("type")
        if "title" not in found and entry_type == "ai-title" and entry.get("aiTitle"):
            found["title"] = entry["aiTitle"]
        if "last_activity_at" in found or entry_type not in ("user", "assistant") or entry.get("isSidechain"):
            continue
        found["last_activity_at"] = iso_to_epoch(entry.get("timestamp"))
        if entry_type == "assistant":
            found["outcome"], found["outcome_detail"] = ("failed", entry.get("error") or "unknown") if entry.get("isApiErrorMessage") else ("done", None)
        else:
            content = (entry.get("message") or {}).get("content")
            texts = [content] if isinstance(content, str) else [block.get("text", "") for block in content or [] if isinstance(block, dict)]
            if not any("[Request interrupted by user" in text for text in texts):
                found["outcome"], found["outcome_detail"] = "needs_approval", "unanswered"
    return found


def command_sweep(arguments):
    os.makedirs(LOCKS_DIR, exist_ok=True)
    if arguments[:1] == ["--if-older-than"] and len(arguments) > 1:
        try:
            if now_epoch() - os.stat(SWEEP_STAMP_FILE).st_mtime < float(arguments[1]):
                return
        except FileNotFoundError:
            pass
    try:
        if time.time() - os.stat(SWEEP_LOCK_DIR).st_mtime > 120:
            os.rmdir(SWEEP_LOCK_DIR)
    except OSError:
        pass
    if not acquire_lock(SWEEP_LOCK_DIR, timeout_seconds=0, steal_when_stale=False):
        return
    try:
        sweep_registry()
        with open(SWEEP_STAMP_FILE, "a"):
            pass
        os.utime(SWEEP_STAMP_FILE)
    finally:
        release_lock(SWEEP_LOCK_DIR)


def sweep_registry():
    current_time = now_epoch()
    settle_after_seconds = SETTLE_DAYS * 86400
    live_sessions = live_claude_processes()

    # 1. Backfill / refresh from transcripts (top-level only; subagent transcripts live one level deeper).
    for transcript_path in glob.glob(os.path.join(CLAUDE_PROJECTS_DIR, "*", "*.jsonl")):
        session_id = os.path.basename(transcript_path)[:-len(".jsonl")]
        if not SESSION_ID_PATTERN.match(session_id):
            continue
        try:
            transcript_stat = os.stat(transcript_path)
        except OSError:
            continue
        existing_thread = load_thread(session_id)
        if existing_thread and existing_thread.get("transcript_mtime") == int(transcript_stat.st_mtime):
            continue
        try:
            parsed = parse_transcript(transcript_path, transcript_stat.st_size)
        except OSError:
            continue
        if not parsed.get("cwd") and not existing_thread:
            continue   # metadata-only stub, nothing to resume

        def merge_backfill(thread, parsed=parsed, transcript_stat=transcript_stat, transcript_path=transcript_path, session_id=session_id):
            is_new_thread = "live_state" not in thread
            thread.setdefault("transcript_path", transcript_path)
            for key in ("cwd", "git_branch", "started_at"):
                if not thread.get(key) and parsed.get(key) is not None:
                    thread[key] = parsed[key]
            thread.setdefault("started_at", int(getattr(transcript_stat, "st_birthtime", transcript_stat.st_mtime)))
            thread["last_activity_at"] = max(thread.get("last_activity_at") or 0, parsed.get("last_activity_at") or int(transcript_stat.st_mtime))
            if parsed.get("title"):
                thread["title"] = parsed["title"]
            thread["transcript_mtime"] = int(transcript_stat.st_mtime)
            if is_new_thread:
                thread.update(source="backfill", live_state="idle" if session_id in live_sessions else "closed")
                if parsed.get("outcome") and "outcome" not in thread:
                    thread.update(outcome=parsed["outcome"], outcome_detail=parsed.get("outcome_detail"))

        update_thread(session_id, merge_backfill)

    # 2. Permanently delete empty threads (a /clear nobody typed into, a session that never wrote a transcript).
    prune_empty_threads(live_sessions)

    # 3. Reconcile liveness and auto-settle.
    windows_to_clear, windows_to_mirror = [], []
    for thread_file_path in glob.glob(os.path.join(THREADS_DIR, "*.json")):
        session_id = os.path.basename(thread_file_path)[:-len(".json")]
        if not SESSION_ID_PATTERN.match(session_id):
            continue

        def reconcile(thread, session_id=session_id):
            live_info = live_sessions.get(session_id)
            was_settled = bool(thread.get("settled"))
            if live_info is not None:
                tmux_location = live_info.get("tmux") or ""
                if "." in tmux_location:
                    session_name, _, window_and_pane = tmux_location.rpartition(":")
                    thread["tmux_window_id"], thread["tmux_pane"] = window_and_pane.split(".", 1)
                    if session_name:
                        thread["tmux_session_name"] = session_name
                if thread.get("live_state") == "closed":
                    thread["live_state"] = "idle"
            elif thread.get("live_state") != "closed" and current_time - (thread.get("last_activity_at") or 0) > CLOSE_GRACE_SECONDS:
                thread.update(live_state="closed", closed_at=current_time)
                if thread.get("tmux_window_id"):
                    windows_to_clear.append((thread["tmux_window_id"], session_id))
            transcript_path = thread.get("transcript_path")
            thread["transcript_missing"] = bool(transcript_path) and not os.path.exists(transcript_path)
            snoozed_until = thread.get("snoozed_until") or 0
            reference_time = max(thread.get("last_activity_at") or 0, thread.get("unsettled_at") or 0,
                                 thread.get("snooze_woke_at") or 0, snoozed_until)
            if (not was_settled and not thread.get("pinned") and thread.get("live_state") != "running"
                    and snoozed_until <= current_time and current_time - reference_time > settle_after_seconds):
                thread.update(settled=True, settled_at=current_time, settled_reason="auto_inactive")
                if live_info is not None and "." in (live_info.get("tmux") or ""):
                    windows_to_mirror.append((session_id, thread["tmux_window_id"]))

        update_thread(session_id, reconcile)

    for window_id, session_id in windows_to_clear:
        # Claude died without SessionEnd: drop markers if the window still claims this session.
        if tmux("show", "-wv", "-t", window_id, "@claude_session_id") == session_id:
            commands = []
            for option_name in ("@claude_session_id", "@claude_running", "@claude_waiting", "@claude_outcome", "@claude_pending_approval_tool",
                                "@claude_pinned", "@claude_snoozed", "@claude_snoozed_label", "@claude_snooze_news", "@claude_settled"):
                commands += ["set", "-wu", "-t", window_id, option_name, ";"]
            tmux(*commands[:-1])
    for session_id, window_id in windows_to_mirror:
        # Window comes from Claude's own pid file, so this also tags windows that predate the hook.
        mirror_to_window(session_id, window_id=window_id)
    recompute_next_wake()


# ---------------------------------------------------------------- snapshot / restore: get windows back after tmux dies

SNAPSHOT_FIELDS = ("session_name", "window_index", "window_id", "window_name", "automatic_rename",
                   "pane_current_path", "claude_session_id")
SNAPSHOT_FORMAT = "\t".join(["#{session_name}", "#{window_index}", "#{window_id}", "#{window_name}", "#{automatic-rename}",
                             "#{pane_current_path}", "#{@claude_session_id}"])


def tmux_server_pid():
    server_pid = tmux("display", "-p", "#{pid}")
    return int(server_pid) if server_pid and server_pid.isdigit() else None


def command_snapshot(arguments):
    """Record every tmux window (per server pid) and refresh launch flags of live Claude sessions."""
    server_pid = tmux_server_pid()
    window_listing = tmux("list-windows", "-a", "-F", SNAPSHOT_FORMAT) if server_pid else None
    if window_listing is not None:
        os.makedirs(SNAPSHOT_DIR, exist_ok=True)
        snapshot_path = os.path.join(SNAPSHOT_DIR, f"{server_pid}.tsv")
        temporary_path = f"{snapshot_path}.tmp.{os.getpid()}"
        with open(temporary_path, "w") as snapshot_file:
            snapshot_file.write(window_listing + "\n")
        os.replace(temporary_path, snapshot_path)
        older_snapshots = sorted((path for path in glob.glob(os.path.join(SNAPSHOT_DIR, "*.tsv*")) if path != snapshot_path),
                                 key=os.path.getmtime, reverse=True)
        for stale_path in older_snapshots[SNAPSHOTS_KEPT:]:
            os.remove(stale_path)
    repair_stale_running_windows()
    # Session name per live thread, so reopening a closed thread puts it back in the same tmux session.
    for line in (window_listing or "").splitlines():
        window = dict(zip(SNAPSHOT_FIELDS, line.split("\t")))
        claude_session_id, session_name = window.get("claude_session_id"), window.get("session_name")
        if claude_session_id and session_name and SESSION_ID_PATTERN.match(claude_session_id):
            thread = load_thread(claude_session_id)
            if thread is not None and thread.get("tmux_session_name") != session_name:
                update_thread(claude_session_id, lambda thread, session_name=session_name: thread.update(tmux_session_name=session_name))
    # Launch flags for every live session (not just pinned ones), so a reopen after a crash keeps them.
    live_sessions = live_claude_processes()
    flags_by_pid = launch_flags_by_pid([info["pid"] for info in live_sessions.values()])
    for session_id, info in live_sessions.items():
        current_flags = flags_by_pid.get(int(info["pid"]))
        thread = load_thread(session_id)
        if current_flags is not None and thread is not None and thread.get("resume_flags") != current_flags:
            update_thread(session_id, lambda thread, current_flags=current_flags: thread.update(resume_flags=current_flags))


STALE_RUNNING_GRACE_SECONDS = 10


def repair_stale_running_windows():
    """Safety net: a window still purple (@claude_running) after the registry says the turn ended gets the
    registry's state re-applied. Done under the thread lock so it can't race a hook mid-write."""
    window_listing = tmux("list-windows", "-a", "-F", "#{window_id}\t#{@claude_session_id}\t#{@claude_running}") or ""
    for line in window_listing.splitlines():
        window_id, session_id, window_running = (line.split("\t") + ["", ""])[:3]
        if window_running != "1" or not session_id or not SESSION_ID_PATTERN.match(session_id):
            continue
        lock_dir = os.path.join(LOCKS_DIR, session_id + ".lock")
        if not acquire_lock(lock_dir, timeout_seconds=0.5, steal_when_stale=False):
            continue   # a hook is writing right now; next minute
        try:
            thread = load_thread(session_id) or {}
            last_change = max(thread.get("last_activity_at") or 0, thread.get("outcome_at") or 0)
            if thread.get("live_state") in (None, "running") or now_epoch() - last_change < STALE_RUNNING_GRACE_SECONDS:
                continue
            outcome = thread.get("outcome")
            commands = ["set", "-wu", "-t", window_id, "@claude_running"]
            if outcome in ("done", "failed", "needs_approval"):
                commands += [";", "set", "-w", "-t", window_id, "@claude_waiting", "1",
                             ";", "set", "-w", "-t", window_id, "@claude_outcome", outcome]
            tmux(*commands)
        finally:
            release_lock(lock_dir)


def restorable_snapshot():
    """Newest snapshot of a tmux server other than the running one (and not already restored), or None."""
    current_server_pid = tmux_server_pid()
    candidates = [path for path in glob.glob(os.path.join(SNAPSHOT_DIR, "*.tsv"))
                  if os.path.basename(path)[:-len(".tsv")] != str(current_server_pid)]
    return max(candidates, key=os.path.getmtime) if candidates else None


def read_snapshot(snapshot_path):
    windows = []
    with open(snapshot_path) as snapshot_file:
        for line in snapshot_file:
            values = line.rstrip("\n").split("\t")
            if len(values) >= len(SNAPSHOT_FIELDS):
                windows.append(dict(zip(SNAPSHOT_FIELDS, values)))
    return windows


def plan_restore(snapshot_windows, claude_only):
    """[(session_name, [window plan, ...]), ...] in snapshot order; skips anything already open or not resumable."""
    live_sessions = live_claude_processes()
    open_threads = live_window_locations()
    open_windows = set()
    for line in (tmux("list-windows", "-a", "-F", "#{session_name}\t#{window_name}\t#{pane_current_path}") or "").splitlines():
        open_windows.add(tuple(line.split("\t")))
    plan, skipped, planned_session_ids = {}, [], set()
    for window in snapshot_windows:
        session_id = window["claude_session_id"]
        window_label = f"{window['session_name']}:{window['window_index']} {window['window_name']}"
        if session_id in planned_session_ids:
            # Two windows on one session (resumed twice) would be two Claude processes writing one transcript.
            skipped.append(f"{window_label} (duplicate of a window already restored)")
            continue
        if session_id:
            thread = load_thread(session_id)
            if not thread:
                skipped.append(f"{window_label} (not in the registry)")
                continue
            if thread.get("settled"):
                skipped.append(f"{window_label} (settled)")
                continue
            if session_id in open_threads or session_id in live_sessions:
                skipped.append(f"{window_label} (already running)")
                continue
            transcript_path = thread.get("transcript_path")
            if transcript_path and not os.path.exists(transcript_path):
                skipped.append(f"{window_label} (transcript deleted)")
                continue
            plan.setdefault(window["session_name"], []).append(dict(window, kind="claude", thread=thread))
            planned_session_ids.add(session_id)
        elif not claude_only:
            if (window["session_name"], window["window_name"], window["pane_current_path"]) in open_windows:
                continue
            plan.setdefault(window["session_name"], []).append(dict(window, kind="shell"))
    return list(plan.items()), skipped


def restore_window(session_name, window):
    """Create one window (or the session itself, for its first window). Returns the new window id or None."""
    if window["kind"] == "claude":
        launch_directory, shell_command = resume_launch(window["claude_session_id"], window["thread"])
    else:
        launch_directory, shell_command = existing_directory(window["pane_current_path"]), None
    window_name = window["window_name"] if window["automatic_rename"] != "1" and window["window_name"] else None
    return new_window_in_session(session_name, launch_directory, shell_command, window_name)


def command_restore(arguments):
    try:
        restore_from_snapshot(arguments)
    finally:
        if "--pause" in arguments and "--hint" not in arguments:
            read_keypress("Press any key to close ")


def restore_from_snapshot(arguments):
    snapshot_path = restorable_snapshot()
    if "--hint" in arguments:
        if snapshot_path:
            plan, _ = plan_restore(read_snapshot(snapshot_path), claude_only=False)
            window_count = sum(len(windows) for _, windows in plan)
            if window_count:
                tmux("display-message", "-d", "8000",
                     f"claude-threads: {window_count} window(s) from the previous tmux server; <prefix>R restores them")
        return
    if not snapshot_path:
        print("No snapshot from a previous tmux server to restore.")
        return
    plan, skipped = plan_restore(read_snapshot(snapshot_path), claude_only="--claude-only" in arguments)
    claude_count = sum(1 for _, windows in plan for window in windows if window["kind"] == "claude")
    window_count = sum(len(windows) for _, windows in plan)
    snapshot_age = format_age(os.path.getmtime(snapshot_path))
    snapshot_when = "just now" if snapshot_age == "now" else f"{snapshot_age} ago"
    print(f"Windows from tmux server {os.path.basename(snapshot_path)[:-len('.tsv')]}, last snapshot {snapshot_when}:")
    for session_name, windows in plan:
        print(f"  {session_name}")
        for window in windows:
            if window["kind"] == "claude":
                description = f"{PURPLE}claude{RESET} {thread_title(window['thread'])}"
            else:
                description = f"{DIM}shell{RESET}"
            print(f"    {window['window_index']:>2} {window['window_name']:<24} {description}  {DIM}{shorten_home(window['pane_current_path'])}{RESET}")
    for reason in skipped:
        print(f"  {DIM}skip {reason}{RESET}")
    if not window_count:
        print("Nothing to restore.")
        return
    if "--dry-run" in arguments:
        return
    if "--yes" not in arguments and not confirm_on_terminal(f"Restore {window_count} window(s), {claude_count} Claude thread(s)?"):
        return
    restored_count, failures = 0, []
    for session_name, windows in plan:
        for window in windows:
            try:
                new_window_id = restore_window(session_name, window)
            except CommandError as error:
                failures.append(f"{window['window_name']}: {error}")
                continue
            if not new_window_id:
                failures.append(f"{window['window_name']}: tmux refused")
                continue
            restored_count += 1
            if window["kind"] == "claude":
                attach_thread_to_window(window["claude_session_id"], window["thread"], new_window_id)
    os.replace(snapshot_path, snapshot_path + ".restored")
    for failure in failures:
        print(f"  {RED}failed{RESET} {failure}")
    print(f"Restored {restored_count} window(s)" + (f", {len(failures)} failed" if failures else "") + ".")


# ---------------------------------------------------------------- inbox: active threads from the registry (<prefix>i)

# Views cycle with tab / shift-tab. The fzf prompt carries the current view; fzf exports it to reload/transform
# commands as $FZF_PROMPT.
INBOX_VIEWS = ("inbox", "pinned", "snoozed", "settled")
INBOX_VIEW_PROMPTS = {view: f"{view}> " for view in INBOX_VIEWS}
INBOX_COMMON_KEYS = "enter: open/resume   ctrl-s: settle   ctrl-z: snooze   ctrl-t: pin/unpin"
INBOX_VIEW_HEADERS = {
    "inbox": INBOX_COMMON_KEYS,
    "pinned": "enter: open/resume   ctrl-s: settle/unsettle   ctrl-z: snooze   ctrl-t: unpin   ctrl-e: edit label",
    "snoozed": "enter: open/resume   ctrl-s: settle   ctrl-z: new time or wake   ctrl-t: pin/unpin",
    "settled": "enter: open/resume   ctrl-s: unsettle   ctrl-z: snooze   ctrl-t: pin/unpin   ctrl-x: DELETE forever",
}
INBOX_SWEEP_MAX_AGE_SECONDS = 300
WOKE_HIGHLIGHT_SECONDS = 3600
INBOX_STATUS_RANK = {"failed": 0, "needs_approval": 1, "done": 2, "idle": 3, "running": 4}
INBOX_STATUS_GLYPH = {"failed": RED + "✗" + RESET, "needs_approval": AMBER + "◆" + RESET, "done": GREEN + "✓" + RESET,
                      "idle": " ", "running": PURPLE + "●" + RESET}


def inbox_status(thread):
    """failed | needs_approval | done | running | idle (closed threads keep the outcome they ended on)."""
    outcome = thread.get("outcome")
    if outcome in ("failed", "needs_approval", "done"):
        return outcome
    return "running" if thread.get("live_state") == "running" else "idle"


def is_snoozed(thread, current_time):
    return (thread.get("snoozed_until") or 0) > current_time


def woke_recently(thread, current_time):
    """Brought back by the snooze timer within the last hour (typing into it or re-snoozing clears this)."""
    return (thread.get("snooze_woke_reason") == "timer" and not is_snoozed(thread, current_time)
            and current_time - (thread.get("snooze_woke_at") or 0) < WOKE_HIGHLIGHT_SECONDS)


def approval_breaks_snooze(thread):
    return thread.get("outcome") == "needs_approval" and thread.get("live_state") == "waiting"


def parked_job_parents(live_sessions=None):
    """Background job session id -> session id of the live interactive session that parked it (its parkedJobId).
    A parked job carries on that session's conversation, so the inbox folds it into the parent's row."""
    live_sessions = live_claude_processes() if live_sessions is None else live_sessions
    job_session_ids = {info["jobId"]: session_id for session_id, info in live_sessions.items()
                       if info.get("kind") == "bg" and info.get("jobId")}
    return {job_session_ids[info["parkedJobId"]]: session_id for session_id, info in live_sessions.items()
            if info.get("kind", "interactive") == "interactive" and info.get("parkedJobId") in job_session_ids}


def inbox_selection(view, job_parents=None):
    """(threads in the view's order, number of snoozed threads hidden from the inbox view).
    Parked background jobs are left out; their parent's row stands for them."""
    current_time = now_epoch()
    job_parents = parked_job_parents() if job_parents is None else job_parents
    threads = [thread for thread in all_threads() if thread.get("session_id") and thread["session_id"] not in job_parents]
    if view == "pinned":   # every pin, settled or snoozed included, in the order you pinned them
        return sorted((thread for thread in threads if thread.get("pinned")), key=lambda thread: thread.get("pinned_at") or 0), 0
    if view == "snoozed":
        snoozed_threads = [thread for thread in threads if is_snoozed(thread, current_time) and not thread.get("settled")]
        return sorted(snoozed_threads, key=lambda thread: thread["snoozed_until"]), 0
    if view == "settled":
        return sorted((thread for thread in threads if thread.get("settled")), key=lambda thread: -(thread.get("settled_at") or 0)), 0
    visible_threads, hidden_snoozed_count = [], 0
    for thread in threads:
        if thread.get("settled"):
            continue
        if is_snoozed(thread, current_time) and not approval_breaks_snooze(thread):
            hidden_snoozed_count += 1
            continue
        visible_threads.append(thread)
    visible_threads.sort(key=lambda thread: (not woke_recently(thread, current_time), not thread.get("pinned"),
                                             INBOX_STATUS_RANK[inbox_status(thread)], -(thread.get("last_activity_at") or 0)))
    return visible_threads, hidden_snoozed_count


def live_window_locations():
    """Claude session id -> ("session:index", window name) for every tmux window that holds a thread (one tmux call).
    The name is "" while tmux is still auto-naming the window after its process (claude, zsh, ...).
    The location gets a "+N windows" suffix when the session is open in several windows (resumed more than once)."""
    window_listing = tmux("list-windows", "-a", "-F",
                          "#{@claude_session_id}\t#{session_name}:#{window_index}\t#{?automatic-rename,,#{window_name}}") or ""
    locations, extra_window_counts = {}, {}
    for line in window_listing.splitlines():
        session_id, location, window_name = (line.split("\t") + ["", ""])[:3]
        if not session_id:
            continue
        if session_id in locations:
            extra_window_counts[session_id] = extra_window_counts.get(session_id, 0) + 1
        else:
            locations[session_id] = (location, window_name)
    for session_id, extra_window_count in extra_window_counts.items():
        location, window_name = locations[session_id]
        locations[session_id] = (f"{location}{RESET} {RED}+{extra_window_count} more window{'s' if extra_window_count > 1 else ''}{RESET}{DIM}",
                                 window_name)
    return locations


def inbox_rows(view):
    current_time = now_epoch()
    window_locations = live_window_locations()
    job_parents = parked_job_parents()
    parked_job_of = {parent_session_id: job_session_id for job_session_id, parent_session_id in job_parents.items()}
    rows = []
    for thread in inbox_selection(view, job_parents)[0]:
        session_id = thread["session_id"]
        pin_mark = AMBER + "^" + RESET if thread.get("pinned") else " "
        status_glyph = INBOX_STATUS_GLYPH[inbox_status(thread)]
        if thread.get("settled"):
            settled_how = "auto, idle" if thread.get("settled_reason") == "auto_inactive" else thread.get("settled_reason") or "manual"
            settled_age = format_age(thread.get("settled_at"))
            settled_when = "just now" if settled_age == "now" else f"{settled_age} ago"
            tag = f"{GRAY}settled {settled_when} ({settled_how}){RESET}  "
        elif woke_recently(thread, current_time):
            tag = f"{AMBER}woke {format_age(thread.get('snooze_woke_at'))}{RESET}  "
        elif is_snoozed(thread, current_time):
            tag = f"{GRAY}zzz {format_clock(thread['snoozed_until'])}{RESET}  "
        else:
            tag = ""
        location, live_window_name = window_locations.get(session_id, (None, ""))
        if location:
            window_name = live_window_name
        else:   # closed: the last name recorded, unless tmux was auto-naming it then
            window_name = thread.get("window_name") if thread.get("window_named") is not False else ""
        title = thread_title(thread)
        if not is_useful_title(window_name) or title.startswith(window_name):
            name = title   # nothing to add, or it would repeat the title (window names get truncated)
        else:
            name = f"{window_name} [{title}]"   # the tmux window name you know it by, then Claude's title
        if location:
            where = location
        elif thread.get("transcript_missing"):
            where = f"{RED}gone (not resumable){RESET}{DIM}"
        elif thread.get("live_state") != "closed":
            where = "live, no tmux window"
        else:
            where = "↺ closed"
        if session_id in parked_job_of:
            job_location = window_locations.get(parked_job_of[session_id], ("",))[0]
            where += f"  + job{' in ' + job_location if job_location else ' in the background'}"
        rows.append(f"thread:{session_id}\t{pin_mark}{status_glyph} {format_age(thread.get('last_activity_at')):>4}  {tag}"
                    f"{name}  {DIM}{where}  {shorten_home(thread.get('cwd'))}  {thread.get('git_branch') or ''}{RESET}")
    return rows


def inbox_footer(view):
    visible_threads, hidden_snoozed_count = inbox_selection(view)
    view_strip = "  ".join(f"[{name}]" if name == view else name for name in INBOX_VIEWS)
    if view == "inbox":
        counts = f"{len(visible_threads)} active" + (f", {hidden_snoozed_count} snoozed" if hidden_snoozed_count else "")
    else:
        counts = f"{len(visible_threads)} {view}"
    return f"{view_strip}   tab / shift-tab   ·   ctrl-/ preview   ·   {counts}"


def current_inbox_view(arguments):
    """Explicit --view NAME, else the view encoded in fzf's prompt, else the inbox."""
    if "--view" in arguments[:-1] and arguments[arguments.index("--view") + 1] in INBOX_VIEWS:
        return arguments[arguments.index("--view") + 1]
    prompt_views = {prompt: view for view, prompt in INBOX_VIEW_PROMPTS.items()}
    return prompt_views.get(os.environ.get("FZF_PROMPT"), "inbox")


def inbox_switch_actions(target_view):
    """fzf actions that move to target_view (the reload passes --view since $FZF_PROMPT may still be the old one)."""
    return (f"change-prompt({INBOX_VIEW_PROMPTS[target_view]})+change-header({INBOX_VIEW_HEADERS[target_view]})"
            f"+reload(claude-threads inbox --rows --view {target_view})+first")


def inbox_snooze_key(target):
    session_id, _ = resolve_target(target)
    default_spec = default_snooze_spec()
    answer = read_line_from_terminal(f"{snooze_question(load_thread(session_id) or {})} [{default_spec}]: ")
    if answer is None:
        return
    try:
        command_snooze([target, answer or default_spec])
    except CommandError as error:
        print(error)
        time.sleep(1.5)


def inbox_label_key(target):
    session_id, _ = resolve_target(target)
    thread = load_thread(session_id) or {}
    new_label = read_line_from_terminal(f"Label [{thread_title(thread)}]: ")
    if new_label:
        update_thread(session_id, lambda thread: thread.update(pin_label=new_label))
        mirror_to_window(session_id)


def inbox_delete_key(target):
    """Errors are held on screen: execute() hides the tmux status line behind the popup."""
    try:
        command_delete([target])
    except CommandError as error:
        print(f"{RED}{error}{RESET}")
        read_keypress("Press any key ")


MINIMUM_FZF_VERSION = (0, 65)   # --footer / transform-footer
FZF_INSTALL_DIRECTORY_BINARY = os.path.expanduser("~/.fzf/bin/fzf")   # where github.com/junegunn/fzf's installer puts it


def fzf_command():
    """fzf from PATH, else the upstream installer's ~/.fzf/bin/fzf. Popups get the tmux server's PATH, which is
    fixed when the server starts and can lack directories your shell adds later."""
    return shutil.which("fzf") or (FZF_INSTALL_DIRECTORY_BINARY if os.access(FZF_INSTALL_DIRECTORY_BINARY, os.X_OK) else None)


def fzf_version_problem():
    """Why the installed fzf can't run the inbox, or None."""
    fzf_path = fzf_command()
    if not fzf_path:
        return (f"fzf is not on this PATH ({os.environ.get('PATH', '')}). tmux popups use the tmux server's PATH: "
                f"run  tmux set-environment -g PATH \"$PATH\"  from a shell where fzf works")
    try:
        version_output = subprocess.run([fzf_path, "--version"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                        text=True).stdout
    except OSError as error:
        return f"can't run {fzf_path}: {error}"
    version_match = re.match(r"\s*(\d+)\.(\d+)", version_output)
    if version_match and tuple(map(int, version_match.groups())) >= MINIMUM_FZF_VERSION:
        return None
    found_version = version_output.split()[0] if version_output.strip() else "unknown"
    return (f"fzf {found_version} is too old; the inbox needs {'.'.join(map(str, MINIMUM_FZF_VERSION))}+ "
            f"(install.sh installs a current one from github.com/junegunn/fzf)")


def command_inbox(arguments):
    view = current_inbox_view(arguments)
    target = arguments[1] if len(arguments) > 1 else ""
    if arguments[:1] == ["--rows"]:
        for row in inbox_rows(view):
            print(row)
        return
    if arguments[:1] == ["--footer"]:
        print(inbox_footer(view))
        return
    if arguments[:1] == ["--cycle"]:
        step = -1 if target == "previous" else 1
        print(inbox_switch_actions(INBOX_VIEWS[(INBOX_VIEWS.index(view) + step) % len(INBOX_VIEWS)]))
        return
    if arguments[:1] == ["--settle-key"] and target:
        # ctrl-s: settle after y/n; on a settled thread it unsettles without asking (it's the undo).
        session_id, _ = resolve_target(target)
        if (load_thread(session_id) or {}).get("settled"):
            command_unsettle([target])
        else:
            command_settle([target, "--confirm"])
        return
    if arguments[:1] == ["--snooze-key"] and target:
        inbox_snooze_key(target)
        return
    if arguments[:1] == ["--label-key"] and target:
        inbox_label_key(target)
        return
    if arguments[:1] == ["--delete-bind"]:
        # ctrl-x does nothing outside the settled view. target is fzf's {1}, i.e. thread:<session_id>.
        session_id = target.removeprefix("thread:")
        if view == "settled" and SESSION_ID_PATTERN.match(session_id):
            print(f"execute(claude-threads inbox --delete-key thread:{session_id})+reload(claude-threads inbox --rows)")
        return
    if arguments[:1] == ["--delete-key"] and target:
        inbox_delete_key(target)
        return

    fzf_problem = fzf_version_problem()
    if fzf_problem:
        raise CommandError(fzf_problem)
    command_sweep(["--if-older-than", str(INBOX_SWEEP_MAX_AGE_SECONDS)])
    if not all_threads():
        notify("Inbox zero: no Claude threads yet")
        return
    rows = inbox_rows("inbox")
    reload_rows = "reload(claude-threads inbox --rows)"
    fzf = subprocess.run(
        [fzf_command(), "--ansi", "--delimiter=\t", "--with-nth=2", "--no-sort", "--layout=reverse",
         "--prompt", INBOX_VIEW_PROMPTS["inbox"], "--header", INBOX_VIEW_HEADERS["inbox"],
         "--footer", inbox_footer("inbox"),
         "--bind", "load:transform-footer(claude-threads inbox --footer)",
         "--bind", "tab:transform(claude-threads inbox --cycle next)",
         "--bind", "shift-tab:transform(claude-threads inbox --cycle previous)",
         "--bind", f"ctrl-s:execute(claude-threads inbox --settle-key {{1}})+{reload_rows}",
         "--bind", f"ctrl-z:execute(claude-threads inbox --snooze-key {{1}})+{reload_rows}",
         "--bind", f"ctrl-t:execute-silent(claude-threads toggle-pin {{1}})+{reload_rows}",
         "--bind", f"ctrl-e:execute(claude-threads inbox --label-key {{1}})+{reload_rows}",
         "--bind", "ctrl-x:transform(claude-threads inbox --delete-bind {1})",
         "--wrap=word", "--bind", "ctrl-/:change-preview-window(down,45%|hidden|right,40%)",
         "--preview", "claude-threads show {1}", "--preview-window=right,40%,wrap"],
        input="\n".join(rows) + ("\n" if rows else ""), stdout=subprocess.PIPE, text=True)
    selection = fzf.stdout.strip()
    if selection:
        open_or_explain(selection.split("\t", 1)[0])


def open_or_explain(target):
    """Open from a popup; a failure is printed and held on screen (a tmux status message would hide behind the popup)."""
    try:
        command_open([target])
    except CommandError as error:
        print(f"{RED}Couldn't open the thread:{RESET} {error}")
        read_keypress("Press any key to close ")


# ---------------------------------------------------------------- dispatch

COMMANDS = {
    "list": command_list, "show": command_show, "set": command_set,
    "pin": command_pin, "unpin": command_unpin, "toggle-pin": command_toggle_pin,
    "open": command_open, "snooze-prompt": command_snooze_prompt,
    "snooze": command_snooze, "wake": command_wake, "wake-due": command_wake_due,
    "settle": command_settle, "unsettle": command_unsettle,
    "delete": command_delete, "prune": command_prune, "sweep": command_sweep, "inbox": command_inbox,
    "snapshot": command_snapshot, "restore": command_restore,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help") or sys.argv[1] not in COMMANDS:
        print(__doc__.strip())
        return 0 if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help") else 2
    os.makedirs(LOCKS_DIR, exist_ok=True)
    try:
        COMMANDS[sys.argv[1]](sys.argv[2:])
    except CommandError as error:
        notify(f"claude-threads: {error}")
        if in_tmux() and sys.stderr.isatty():   # e.g. inside a popup, where the status-line message is hidden
            print(f"claude-threads: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
